      "text": "Vazão de ar aspirado",
      "font_size": 9,
      "bold": false,
      "italic": true,
      "color": "#333333",
      "position": "bottom-left"
    },
    "Eficiencia termica": {
      "text": "Valores negativos -> Eficiência térmica menor com aditivo",
      "font_size": 9,
      "bold": false,
      "italic": true,
      "color": "#333333",
      "position": "bottom-left"
    },
    "CO2 especifico": {
      "text": "Valores maiores representam piora de CO2 -> Aditivado",
      "font_size": 9,
      "bold": false,
      "italic": true,
      "color": "#333333",
      "position": "bottom-left"
    },
    "Consumo absoluto": {
      "text": "Diferenças de consumo majoritariamente dentro das incertezas de medição",
      "font_size": 9,
      "bold": false,
      "italic": true,
      "color": "#333333",
      "position": "bottom-left"
    },
    "P_COLETOR": {
      "text": "Valores estáveis representam repetibilidade entre os ensiaios",
      "font_size": 9,
      "bold": false,
      "italic": true,
      "color": "#333333",
      "position": "bottom-left"
    },
    "PMAX": {
      "text": "Valores menores -> Pressões máximas mais baixas com aditivo",
      "font_size": 9,
      "bold": false,
      "italic": true,
      "color": "#333333",
      "position": "bottom-left"
    },
    "P_S_COMP": {
      "text": "Pressão de saída do compressor estável -> Ensaios repetitivos",
      "font_size": 9,
      "bold": false,
      "italic": true,
      "color": "#333333",
      "position": "bottom-left"
    },
    "P_S_TURB": {
      "text": "Pressão de saída da turbina similar -> Ensaios repetitivos",
